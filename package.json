{
  "name": "kitchen-chaos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc && vite build",
    "buildDbg": "VITE_DEBUG=true npm run build",
    "preview": "vite preview",
    "nuke": "rm -rf dist docs node_modules package-lock.json && npm cache clean --force",
    "clean": "rm -rf dist docs",
    "test": "vitest",
    "docs": "typedoc --entryPointStrategy expand src",
    "docs:serve": "typedoc --entryPointStrategy expand src && python -m http.server 8080 --directory docs"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.1.0",
    "@babylonjs/gui-editor": "^9.1.0",
    "@babylonjs/inspector": "^9.1.0",
    "terser": "^5.46.1",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
